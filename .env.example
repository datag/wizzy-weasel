# Contact address of the site operator. Rendered as a mailto link in the footer.
# If the variable is not set, the contact section is hidden.
APP_OPERATOR_MAIL=operator@example.com

# Base URL of the bilingual privacy policy. The footer links to the language
# sections via the anchors #de and #en, so both anchors must exist on the
# target page. If the variable is not set, the links are hidden.
APP_PRIVACY_POLICY_URL=https://www.example.com/privacy
